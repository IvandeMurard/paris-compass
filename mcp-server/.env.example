# Optionnel depuis le 2 septembre 2026, quand ce serveur est devenu un paquet npm (#35).
#
# Le serveur porte l'URL et la clé publiable du projet public de Compass — voir src/supabase.ts
# et la raison qui y est écrite : un agent extérieur n'a aucun moyen d'obtenir ces valeurs, donc
# les exiger de lui rendrait le paquet inutilisable. Ce fichier ne sert plus qu'à viser un AUTRE
# projet, et l'environnement prime sur les valeurs intégrées.
#
# Jamais une clé de service ici : l'agent obtient exactement ce qu'obtient un visiteur anonyme,
# et rien de plus — c'est la frontière que l'invariant I11 (eval/invariants.sql) tient.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=sb_publishable_...

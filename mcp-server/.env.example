# Same project, same anon key as the browser uses (VITE_SUPABASE_URL /
# VITE_SUPABASE_PUBLISHABLE_KEY in the app's own .env.local). Never a service
# key here: the agent gets exactly what an anonymous visitor gets, nothing
# more — that is the trust boundary I11 (eval/invariants.sql) exists to hold.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=sb_publishable_...
